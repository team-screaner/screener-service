# Local development only. Compose binds ports to 127.0.0.1.
POSTGRES_PASSWORD=screener-local-only
# Used by native go run; Compose supplies its internal database address separately.
DATABASE_URL=postgres://screener:screener-local-only@127.0.0.1:15432/screener?sslmode=disable
HTTP_ADDR=:8080
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
MIGRATIONS_DIR=migrations

# Development only. Production: generate 32 random bytes and persist the base64 key securely.
RESPONSE_ENCRYPTION_KEY=c2NyZWVuZXItZGV2ZWxvcG1lbnQtb25seS1rZXktMDE=

# Host port for Docker Compose (change if 8080 is already used).
HTTP_PORT=8080
